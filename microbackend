// sync-deps.js
const fs = require('fs');
const path = require('path');
const repos = [
  '../codespaces-jupyter/package.json',
  '../underground-platformm/package.json',
  '../nextjs/package.json'
];
const sharedDeps = {
  'react': '^19.2.4',
  'next': '^16.2.4',
  // adicione outras dependências comuns
};
repos.forEach(repoPath => {
  const fullPath = path.join(__dirname, repoPath);
  if (fs.existsSync(fullPath)) {
    const pkg = require(fullPath);
    Object.keys(sharedDeps).forEach(dep => {
      if (pkg.dependencies && pkg.dependencies[dep]) {
        pkg.dependencies[dep] = sharedDeps[dep];
      }
      if (pkg.devDependencies && pkg.devDependencies[dep]) {
        pkg.devDependencies[dep] = sharedDeps[dep];
      }
    });
    fs.writeFileSync(fullPath, JSON.stringify(pkg, null, 2));
  }
});